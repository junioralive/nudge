{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nudge",
  "main": "web/worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "nudge-db", "migrations_dir": "web/migrations" }
  ],
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "VOICE_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_TIMEZONE": "UTC",
    "NUDGE_PROFILE_NAME": "Junior",
    "VAPID_SUBJECT": "https://nudge.example.com"
  }
}
