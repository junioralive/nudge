{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nudge",
  "main": "web/worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "VAPID_SUBJECT": "https://github.com/junioralive/nudge"
  },
  "assets": {
    "directory": "web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/email/mcp",
      "/email/mcp/*",
      "/memories/mcp",
      "/memories/mcp/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nudge-db",
      "migrations_dir": "web/migrations",
      "database_id": "83ff10cb-1b0f-43d8-8073-0078dacd4707"
    },
    {
      "binding": "MEMORY_DB",
      "database_name": "nudge-memories",
      "database_id": "76b8d867-9de7-4da0-9c01-a6d04a1793b4"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EMAIL_KV"
    },
    {
      "binding": "MEMORY_CONFIG_KV"
    }
  ],
  "vectorize": [
    {
      "binding": "MEMORY_VECTORIZE",
      "index_name": "nudge-memories-vectors"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "MyMCP"
      },
      {
        "name": "MEMORY_MCP_OBJECT",
        "class_name": "MemoriesMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "email-mcp-v1",
      "new_sqlite_classes": [
        "MyMCP"
      ]
    },
    {
      "tag": "memories-mcp-v1",
      "new_sqlite_classes": [
        "MemoriesMCP"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "VOICE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *",
      "0 1 * * *"
    ]
  }
}
